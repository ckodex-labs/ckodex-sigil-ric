# Rust build artifacts
/target
**/*.rs.bk

# Zig build artifacts
zig-cache/
zig-out/
.zig-cache/

# Compiled test binary at repo root
/test

# OS / editor noise
.DS_Store
*.swp
*.swo

# Local env / secrets — never committed
.env
.env.*
*.pem
*.key

# CocoIndex Code (ccc) — index DBs ignored, settings.yml stays tracked
/.cocoindex_code/*.db
/.cocoindex_code/cocoindex.db/

# graft's local graph cache — regenerable, not committed (run `graft build`).
# .ignore re-admits the tree to ripgrep and stays tracked.
/graft/
ci/target/
ci-out/
